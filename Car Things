local function createSlider(name, displayName, y, minVal, maxVal, defaultVal)
	local trackH = 6
	local thumbSize = 16

	-- Row label + value
	local row = Instance.new("Frame")
	row.Size             = UDim2.new(1, -24, 0, 18)
	row.Position         = UDim2.new(0, 12, 0, y)
	row.BackgroundTransparency = 1
	row.Parent           = content

	local nameLbl = Instance.new("TextLabel")
	nameLbl.Size             = UDim2.new(0.5, 0, 1, 0)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Text             = displayName
	nameLbl.TextColor3       = Color3.fromRGB(200, 200, 220)
	nameLbl.Font             = Enum.Font.GothamBold
	nameLbl.TextSize         = 12
	nameLbl.TextXAlignment   = Enum.TextXAlignment.Left
	nameLbl.Parent           = row

	local valLbl = Instance.new("TextLabel")
	valLbl.Size              = UDim2.new(0.5, 0, 1, 0)
	valLbl.Position          = UDim2.new(0.5, 0, 0, 0)
	valLbl.BackgroundTransparency = 1
	valLbl.Text              = string.format("%.2f", defaultVal or minVal)
	valLbl.TextColor3        = Color3.fromRGB(60, 120, 255)
	valLbl.Font              = Enum.Font.GothamBold
	valLbl.TextSize          = 12
	valLbl.TextXAlignment    = Enum.TextXAlignment.Right
	valLbl.Parent            = row

	-- Track background
	local track = Instance.new("Frame")
	track.Size             = UDim2.new(1, -24, 0, trackH)
	track.Position         = UDim2.new(0, 12, 0, y + 22)
	track.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	track.BorderSizePixel  = 0
	track.Parent           = content
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	-- Track fill
	local fill = Instance.new("Frame")
	fill.Size             = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
	fill.BorderSizePixel  = 0
	fill.Parent           = track
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	-- Thumb
	local thumb = Instance.new("Frame")
	thumb.Size             = UDim2.new(0, thumbSize, 0, thumbSize)
	thumb.Position         = UDim2.new(0, -thumbSize/2, 0.5, -thumbSize/2)
	thumb.BackgroundColor3 = Color3.new(1, 1, 1)
	thumb.BorderSizePixel  = 0
	thumb.ZIndex           = 3
	thumb.Parent           = track
	Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

	-- Thumb inner dot
	local dot = Instance.new("Frame")
	dot.Size             = UDim2.new(0, 6, 0, 6)
	dot.Position         = UDim2.new(0.5, -3, 0.5, -3)
	dot.BackgroundColor3 = Color3.fromRGB(60, 120, 255)
	dot.BorderSizePixel  = 0
	dot.ZIndex           = 4
	dot.Parent           = thumb
	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

	SliderData[name] = { label = valLbl, fill = fill, thumb = thumb }

	-- Set initial position
	local function setPct(pct)
		pct = math.clamp(pct, 0, 1)
		fill.Size     = UDim2.new(pct, 0, 1, 0)
		thumb.Position = UDim2.new(pct, -thumbSize/2, 0.5, -thumbSize/2)
	end

	if defaultVal then
		setPct((defaultVal - minVal) / (maxVal - minVal))
		valLbl.Text = string.format("%.2f", defaultVal)
	end

	local dragging = false

	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
		end
	end)
	thumb.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)

	RunService.RenderStepped:Connect(function()
		if not dragging then return end

		local pct = math.clamp(
			(mouse.X - track.AbsolutePosition.X) / track.AbsoluteSize.X,
			0, 1
		)
		local value = minVal + pct * (maxVal - minVal)

		setPct(pct)
		valLbl.Text = string.format("%.2f", value)

		if name == "PULSE" then
			PulseStrength = value
			return
		end

		if name == "MAIN" then
			for _, w in ipairs({"FL","FR","RL","RR"}) do setWheel(w, value) end
		elseif name == "FRONT" then
			setWheel("FL", value)
			setWheel("FR", value)
		elseif name == "REAR" then
			setWheel("RL", value)
			setWheel("RR", value)
		else
			setWheel(name, value)
		end
	end)
end


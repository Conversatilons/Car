local function makeButton(text, y, h, color, callback)
	local bg = Instance.new("Frame")
	bg.Size             = UDim2.new(1, -24, 0, h)
	bg.Position         = UDim2.new(0, 12, 0, y)
	bg.BackgroundColor3 = color
	bg.BorderSizePixel  = 0
	bg.Parent           = content
	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 8)

	local b = Instance.new("TextButton")
	b.Size                   = UDim2.new(1, 0, 1, 0)
	b.BackgroundTransparency = 1
	b.TextColor3             = Color3.new(1, 1, 1)
	b.Text                   = text
	b.Font                   = Enum.Font.GothamBold
	b.TextSize               = 12
	b.Parent                 = bg

	b.MouseButton1Click:Connect(callback)

	-- hover effect
	b.MouseEnter:Connect(function()
		bg.BackgroundColor3 = color:Lerp(Color3.new(1,1,1), 0.12)
	end)
	b.MouseLeave:Connect(function()
		bg.BackgroundColor3 = color
	end)

	return b
end

local function makeHalfButton(text, xOffset, y, h, color, callback)

------------------------------------------------
-- DETECTION
-- 1. Find nearest model named "Wheels"
-- 2. Confirm it has FL FR RL RR as direct children
-- 3. Search anywhere INSIDE each child for object with "spring" in name
------------------------------------------------
local function findSpringInWheel(wheelPart)
	for _, desc in ipairs(wheelPart:GetDescendants()) do
		if desc.Name:lower():find("spring") then
			-- verify it has FreeLength
			local ok, _ = pcall(function() return desc.FreeLength end)
			if ok then
				return desc
			end
		end
	end
	return nil
end

local function findNearestCar()
	print("[SUS] Scanning for nearest Wheels model...")

	local char = player.Character or player.CharacterAdded:Wait()
	local root = char:WaitForChild("HumanoidRootPart")

	local nearestModel = nil
	local nearestDist  = math.huge

	-- Find nearest model literally named "Wheels"
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and obj.Name == "Wheels" then
			local primary = obj.PrimaryPart
			local pos = primary and primary.Position
				or (obj:FindFirstChildWhichIsA("BasePart") and obj:FindFirstChildWhichIsA("BasePart").Position)
			if pos then
				local d = (pos - root.Position).Magnitude
				if d < nearestDist then
					nearestDist  = d
					nearestModel = obj
				end
			end
		end
	end

	if not nearestModel then
		warn("[SUS] No model named 'Wheels' found in workspace")
		return false
	end

	print("[SUS] Found Wheels model:", nearestModel:GetFullName(), "| dist:", string.format("%.1f", nearestDist))

	-- Verify direct children FL FR RL RR exist
	local wheelNames = {"FL", "FR", "RL", "RR"}
	local found = {}
	for _, name in ipairs(wheelNames) do
		local child = nearestModel:FindFirstChild(name)
		if child then
			found[name] = child
			print("[SUS] Verified child:", name)
		else
			warn("[SUS] Missing child:", name)
		end
	end

	if not (found.FL or found.FR or found.RL or found.RR) then
		warn("[SUS] Wheels model has none of FL/FR/RL/RR as children — wrong model?")
		return false
	end

	-- Find springs inside each wheel
	Springs  = {}
	Defaults = {}

	for name, wheelPart in pairs(found) do
		local spring = findSpringInWheel(wheelPart)
		Springs[name] = spring
		if spring then
			local ok, val = pcall(function() return spring.FreeLength end)
			if ok then Defaults[name] = val end
			print("[SUS] Spring found for", name, "->", spring:GetFullName())
		else
			warn("[SUS] No spring found inside", name)
		end
	end

	return true
end


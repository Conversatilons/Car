local function addNeonOutline(part)
	if not part or not part:IsA("BasePart") then return end
	local sel = Instance.new("SelectionBox", workspace)
	sel.Adornee             = part
	sel.Color3              = Color3.fromRGB(0,255,120)
	sel.LineThickness       = 0.07
	sel.SurfaceTransparency = 0.75
	sel.SurfaceColor3       = Color3.fromRGB(0,255,100)
	local t0 = tick()
	local conn; conn = RunService.RenderStepped:Connect(function()
		local e = tick()-t0
		if e >= 2 then pcall(function() sel:Destroy() end); conn:Disconnect(); return end
		local fade    = e/2
		local flicker = e < 0.4 and (0.5+0.5*math.sin(e*math.pi*24)) or 1
		sel.SurfaceTransparency = 0.75+0.25*fade
		sel.Color3 = Color3.fromRGB(0, math.floor(255*(1-fade)*flicker+60*fade), math.floor(80+40*(1-fade)))
	end)
end

local function updateTargetLbl()
	if #selectedParts == 0 then
		targetLbl.Text = "Target: NONE"
	elseif #selectedParts == 1 then
		targetLbl.Text = "Target: "..selectedParts[1].Name
	else
		targetLbl.Text = "Target: "..selectedParts[1].Name.."  (+"..( #selectedParts-1).." more)"
	end
end

local function clearTargets() selectedParts = {}; updateTargetLbl() end

local function addTarget(p)
	if not p then return end
	for _,x in ipairs(selectedParts) do if x==p then return end end
	table.insert(selectedParts, p)
	updateTargetLbl()
	addNeonOutline(p)
end

local function getHRP()
	local ch = player.Character or player.CharacterAdded:Wait()
	return ch:WaitForChild("HumanoidRootPart")
end

local function findByPath(txt)
	if not txt or txt=="" then return nil end
	txt = txt:gsub("%s+","")
	if txt:lower():sub(1,10)=="workspace." then txt=txt:sub(11) end
	local cur = workspace
	for seg in txt:gmatch("[^%.]+") do
		local found
		for _,ch in ipairs(cur:GetChildren()) do
			if ch.Name:lower()==seg:lower() then found=ch; break end
		end
		if not found then return nil end
		cur = found
	end
	return (cur and cur:IsA("BasePart")) and cur or nil
end

local function findNearest(q)
	local hrp = getHRP()
	local best, bestD, bestS = nil, math.huge, -1
	q = tostring(q):lower()
	for _,obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local n = obj.Name:lower()
			if n:find(q,1,true) then
				local d = (obj.Position-hrp.Position).Magnitude
				local s = n==q and 1000 or (500-(#n-#q))
				if s>bestS or (s==bestS and d<bestD) then best,bestD,bestS=obj,d,s end
			end
		end
	end
	return best
end

local function findPart(txt)
	if not txt or txt=="" then txt="#Weight" end
	return findByPath(txt) or findNearest(txt)
end

local function getDir(part, reversed)
	if not part then return Vector3.zero end
	local lk = part.CFrame.LookVector
	local rt = part.CFrame.RightVector
	local up = Vector3.new(0,1,0)
	local v  = Vector3.zero
	if dirs.FORWARD then v+=lk end
	if dirs.BACK    then v-=lk end
	if dirs.RIGHT   then v+=rt end
	if dirs.LEFT    then v-=rt end
	if dirs.UP      then v+=up end
	if dirs.DOWN    then v-=up end
	if v.Magnitude==0 then return Vector3.zero end
	v = v.Unit
	if reversed then v=-v end
	return v
end


local function setTurbo(on)
	if turboActive==on then return end
	turboActive = on
	visTurbo(on)
	if not soundMuted then
		if on then turboLoop:Play() else turboLoop:Stop(); bovSound:Play() end
	else
		if not on then turboLoop:Stop() end
	end
end

local function setPassive(on) passiveActive=on; visPassive(on) end
local function setRev(on)     passiveRevActive=on; visRev(on)  end


local function pulseFront()
	if pulseActive then return end
	pulseActive = true

	local fl = Springs.FL
	local fr = Springs.FR
	if not fl or not fr then
		warn("[SUS] No front springs for pulse")
		pulseActive = false
		return
	end

	local dFL = Defaults.FL or fl.FreeLength
	local dFR = Defaults.FR or fr.FreeLength

	pcall(function()
		fl.FreeLength = 0.5
		fr.FreeLength = 0.5
	end)
	task.wait(0.05)
	pcall(function()
		fl.FreeLength = PulseStrength
		fr.FreeLength = PulseStrength
	end)
	task.wait(0.18)
	pcall(function()
		fl.FreeLength = dFL
		fr.FreeLength = dFR
	end)

	pulseActive = false
end

UIS.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.K then
		pulseFront()
	end
end)


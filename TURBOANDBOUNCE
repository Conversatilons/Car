UserInputService.InputBegan:Connect(function(inp, gpe)
	if gpe then return end

	if rebindTarget then
		keybinds[rebindTarget].key = inp.KeyCode
		local ref = kbBtnRefs[rebindTarget]
		if ref then ref.Text = kn(inp.KeyCode); ref.TextColor3 = ACCENT end
		rebindTarget = nil
		return
	end

	local kc = inp.KeyCode
	if kc == keybinds.turbo.key then
		if keybinds.turbo.holdMode then setTurbo(true) else setTurbo(not turboActive) end
	end
	if kc == keybinds.passive.key then
		if keybinds.passive.holdMode then holdingW = true else setPassive(not passiveActive) end
	end
	if kc == keybinds.passiveRev.key then
		if keybinds.passiveRev.holdMode then holdingS = true else setRev(not passiveRevActive) end
	end
end)

UserInputService.InputEnded:Connect(function(inp)
	local kc = inp.KeyCode
	if kc==keybinds.turbo.key      and keybinds.turbo.holdMode      then setTurbo(false)  end
	if kc==keybinds.passive.key    and keybinds.passive.holdMode     then holdingW = false  end
	if kc==keybinds.passiveRev.key and keybinds.passiveRev.holdMode  then holdingS = false  end
end)

local driveConn = RunService.RenderStepped:Connect(function(dt)

	if turboActive and not soundMuted and not turboLoop.IsPlaying then
		turboLoop:Play()
	end

	for _, part in ipairs(selectedParts) do
		if part and part:IsDescendantOf(workspace) then
			pcall(function() part:SetNetworkOwner(player) end)

			if turboActive then
				local dir = getDir(part, false)
				if dir.Magnitude > 0 then
					currentBoost += (targetBoost - currentBoost) * 0.1
					part.AssemblyLinearVelocity += dir * (currentBoost * dt * 10)
				end
			else
				currentBoost = currentBoost * 0.85
			end

			local doPassive = passiveActive and
				(not keybinds.passive.holdMode or holdingW)
			if doPassive then
				local dir = getDir(part, false)
				if dir.Magnitude > 0 then
					part.AssemblyLinearVelocity += dir * (passiveBoost * dt * 10)
				end
			end

			local doRev = passiveRevActive and
				(not keybinds.passiveRev.holdMode or holdingS)
			if doRev then
				local dir = getDir(part, true)
				if dir.Magnitude > 0 then
					if brakeMode then
						local vel = part.AssemblyLinearVelocity
						local fwdSpeed = vel:Dot(-dir)
						if fwdSpeed > 0 then
							local force = math.min(fwdSpeed / dt, reverseBoost * 10)
							part.AssemblyLinearVelocity += dir * (force * dt)
						end
					else
						part.AssemblyLinearVelocity += dir * (reverseBoost * dt * 10)
					end
				end
			end

		end
	end
end)

table.insert(_G.TURBO_Conn, driveConn)
